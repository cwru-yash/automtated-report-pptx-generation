<!DOCTYPE html>
<html lang="{{ language }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ labels.report_title }} - {{ bundle.wave_id }}</title>
  {% block styles %}{% endblock %}
</head>
<body>
  <header>
    <h1>{{ labels.report_title }}</h1>
    <p class="meta">{{ labels.prepared_by }} | {{ labels.date_format }}</p>
  </header>
  <main>
    {% block content %}{% endblock %}
  </main>
  <footer>
    <p>{{ labels.confidential }}</p>
  </footer>
</body>
</html>
