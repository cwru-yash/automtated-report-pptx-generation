{% extends "base.html.j2" %}

{% block styles %}
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 12pt;
    color: #000;
    background: #fff;
    line-height: 1.6;
  }

  header {
    border-bottom: 2px solid #000;
    padding-bottom: 0.5rem;
    margin-bottom: 1.5rem;
  }

  header h1 { font-size: 18pt; }
  header .meta { font-size: 10pt; color: #555; margin-top: 0.25rem; }
  main { max-width: 100%; }

  section {
    margin-bottom: 1.5rem;
    page-break-inside: avoid;
  }

  section h2 {
    font-size: 13pt;
    font-weight: bold;
    border-bottom: 1px solid #ccc;
    padding-bottom: 0.25rem;
    margin-bottom: 0.5rem;
  }

  footer {
    border-top: 1px solid #ccc;
    margin-top: 2rem;
    padding-top: 0.5rem;
    font-size: 9pt;
    color: #777;
  }
</style>
{% endblock %}

{% block content %}
{% for key in section_order %}
  {% if key in sections %}
  <section id="{{ key }}">
    <h2>{{ labels.get(key, key) }}</h2>
    <p>{{ sections[key] }}</p>
  </section>
  {% endif %}
{% endfor %}
{% endblock %}
