{% extends "base.html.j2" %}

{% block styles %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', sans-serif;
    background: #f4f6f9;
    color: #1a2b4a;
    line-height: 1.7;
  }

  header {
    background: #1a2b4a;
    color: #fff;
    padding: 2.5rem 3rem;
    border-bottom: 4px solid #e8b84b;
  }

  header h1 {
    font-size: 2rem;
    font-weight: 700;
  }

  header .meta {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    color: #a8bdd6;
  }

  main {
    max-width: 960px;
    margin: 2.5rem auto;
    padding: 0 2rem;
    display: grid;
    gap: 1.5rem;
  }

  section.card {
    background: #fff;
    border-radius: 8px;
    padding: 2rem;
    box-shadow: 0 2px 12px rgba(26, 43, 74, 0.08);
    border-left: 4px solid #e8b84b;
  }

  section.card h2 {
    font-size: 1.125rem;
    font-weight: 600;
    color: #1a2b4a;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  section.card p {
    color: #4a5568;
    font-size: 0.95rem;
  }

  footer {
    text-align: center;
    padding: 1.5rem;
    font-size: 0.75rem;
    color: #a0aec0;
    border-top: 1px solid #e2e8f0;
    margin-top: 2rem;
  }
</style>
{% endblock %}

{% block content %}
{% for key in section_order %}
  {% if key in sections %}
  <section class="card" id="{{ key }}">
    <h2>{{ labels.get(key, key) }}</h2>
    <p>{{ sections[key] }}</p>
  </section>
  {% endif %}
{% endfor %}
{% endblock %}
